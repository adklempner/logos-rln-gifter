# tools/allocator/docker/delivery.env — copy to delivery.env for
# delivery-compose.yml (CLIENT_MODE=delivery). Fill the allocator block from
# the operator's allocator.json, then pick ONE of the ready blocks at the end.
#
# WARNING: the delivery-data volume this container writes holds the RLN
# keystore, i.e. the membership SECRET, plus the lez wallet. Back it up
# (CLIENT.md §5); `docker compose -f delivery-compose.yml down -v` destroys it
# and the grant it cost.
#
# Host ports (DELIVERY_HOST_TCP, default 30303, and DELIVERY_HOST_DISCV5,
# default 9000) are compose interpolation: set them in the shell or a .env
# file, not here.

# ---------------------------------------------------------------- allocator
# The operator's gifter_peer_id (required).
ALLOCATOR_PEER_ID=
# The operator's gifter_multiaddr (required); IPv4 only (/dns4 does not resolve in the container).
ALLOCATOR_MULTIADDR=/ip4/<allocator host ip>/tcp/9000

# ---------------------------------------------------------------- credential
# Auth vector the allocator verifies: eth-allowlist, pow-claim, or none (open allocator).
CLIENT_AUTH_TYPE=eth-allowlist
# Producer module that makes the payload for the module-generated commitment: allowlist_sign_module (eth-, logos-, lez-allowlist) or pow_claim_capture_module.
CLIENT_AUTH_PROVIDER=allowlist_sign_module
# Producer args (JSON); eth: {"private_key":"0x<32-byte hex>"} for a stable allowlisted address; pow-claim: see the pow block below.
CLIENT_AUTH_ARGS=
# Precomputed hex auth payload instead of a producer (rarely useful here: a keycard attestation is bound to a commitment, and this mode generates its own).
CLIENT_AUTH_PAYLOAD=
# rate_limit of the membership (the allocator caps it).
CLIENT_RATE=100

# ---------------------------------------------------------------- registry
# Registry the membership is bought on (default: the hosted testnet registry).
REGISTRY_ID=logos:testnet:fd322d32a46ddf57eece9db8d68e9b722262d1f770760fca63b8cb9e7775b971
# Application scope of the proofs; must match every peer (default: logos.test's identifier).
RLN_IDENTIFIER=5e269b6a19fce081f5808b13442dcbc3522197638dd38df5a28bc4e55236b977
# Epoch length given to rln start; must match the preset (logos.test: 600).
EPOCH_SIZE_SEC=600
# Sequencer the lez wallet syncs against.
LEZ_RLN_SEQUENCER=https://testnet.lez.logos.co/
# 1 = register through the allocator when no membership is active; 0 = never register.
DELIVERY_REGISTER=1
# Seconds to wait for a registration to go active before parking (it is still watched).
REG_WAIT_S=600
# Seconds to wait for the lez wallet to report ready (about 3 min measured).
WALLET_WAIT_S=900
# Seconds to wait for get_valid_roots after the wallet is ready.
ROOTS_WAIT_S=300

# ---------------------------------------------------------------- delivery node
# Delivery preset; set but EMPTY = the flat two-node config (cluster DELIVERY_CLUSTER_ID, no discovery).
DELIVERY_PRESET=logos.test
# 1 = this node validates incoming RLN proofs (logos.test ships validation off).
DELIVERY_VALIDATE=0
# Cluster id of the flat config (ignored with a preset).
DELIVERY_CLUSTER_ID=198
# Public IPv4 to advertise (nat extip:<ip>); empty = nat none (outbound only).
DELIVERY_EXTIP=
# Static peers, comma-separated /ip4/…/tcp/…/p2p/… multiaddrs.
DELIVERY_STATICNODES=
# Content topic both sides use.
DELIVERY_TOPIC=/rln-gifter/1/delivery-demo/proto
# receiver (prints what arrives) or sender (publishes DELIVERY_SEND).
DELIVERY_ROLE=receiver
# Text the sender publishes (a "#n <time>" suffix keeps each send unique); empty = a default greeting.
DELIVERY_SEND=
# 0 = send once; N = send again every N seconds.
DELIVERY_SEND_EVERY_S=0

# ---------------------------------------------------------------- operations
# Status line / received-message / parked-reason interval, seconds.
DELIVERY_STATUS_EVERY_S=60
# Seconds the sender waits for a non-Disconnected connection status before its first send.
DELIVERY_CONNECT_WAIT_S=600
# Seconds to wait for each send's proof request and messagePropagated events.
DELIVERY_EVENT_WAIT_S=90
# Seconds to wait for delivery's rlnState to report Ready after createNode.
DELIVERY_RLN_READY_S=180
# Budget of one logosctl call, seconds (the CLI itself gives up after ~20 s).
CALL_TIMEOUT=60

# ================================================================ ready blocks
# Uncomment ONE block; its lines override the values above (later wins).

# --- A: pow-claim (sender) ---
# ALLOCATOR_PEER_ID=<gifter_peer_id>
# ALLOCATOR_MULTIADDR=/ip4/<allocator public ip>/tcp/<port>
# CLIENT_AUTH_TYPE=pow-claim
# CLIENT_AUTH_PROVIDER=pow_claim_capture_module
# CLIENT_AUTH_ARGS={"node_url":"http://host.docker.internal:8080","audience":"","rate_max":100,"claim_block_id":"<hex>","pow_nullifier":"<hex>"}
# DELIVERY_ROLE=sender
# DELIVERY_SEND=hello from the pow node

# --- B: eth-allowlist on the LAN / same host (receiver) ---
# Same host as the allocator: the Docker host gateway; another machine: /ip4/<allocator host ip>/tcp/9000.
# ALLOCATOR_PEER_ID=<gifter_peer_id>
# ALLOCATOR_MULTIADDR=/ip4/192.168.65.254/tcp/9000
# CLIENT_AUTH_TYPE=eth-allowlist
# CLIENT_AUTH_PROVIDER=allowlist_sign_module
# CLIENT_AUTH_ARGS={"private_key":"0x<fresh key: openssl rand -hex 32>"}
# DELIVERY_ROLE=receiver

# --- C: flat two-node stretch (no public fleet; on BOTH nodes, A also sets the
# static peer; B's 30303 must be reachable from A) ---
# DELIVERY_PRESET=
# DELIVERY_VALIDATE=1
# DELIVERY_STATICNODES=/ip4/<peer ip>/tcp/30303/p2p/<peer id>
