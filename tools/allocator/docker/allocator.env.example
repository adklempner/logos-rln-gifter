# tools/allocator/docker/allocator.env — copy to allocator.env and fill in.
# Read by compose (`env_file`) and by the container's entrypoint. Plain
# KEY=VALUE, no quotes needed (compose does not run a shell over this file).

# --- reachability ------------------------------------------------------------
# TCP port the allocator listens on inside the container: leave at 9000; the
# host port is HOST_PORT at compose time (`HOST_PORT=9100 docker compose up -d`,
# then ADVERTISE_PORT=9100), since compose cannot read it from this file.
# Open/forward the host port on the Mac's firewall and router. The follower
# node (node/) publishes NODE_NET_PORT/udp (3000) and 127.0.0.1:NODE_API_PORT
# (18080), so 9000 is free unless you use it elsewhere.
LISTEN_PORT=9000
# What testers dial: a stable IPv4 of the host (public, or the VPS/relay that
# forwards to it), or a DNS name that resolves to it. If both are set,
# ADVERTISE_DNS wins (README §9). This goes verbatim into allocator.json as gifter_multiaddr (/ip4/<ip>/tcp/<port> or
# /dns4/<name>/tcp/<port>).
ADVERTISE_IP=
ADVERTISE_DNS=
# Port in gifter_multiaddr when it differs from 9000 (a HOST_PORT, a
# forward). Default: LISTEN_PORT.
ADVERTISE_PORT=
# Extra multiaddrs published in allocator.json as alt_multiaddrs (informational:
# LAN testers can dial one instead), comma-separated.
ALT_MULTIADDRS=

# --- registry (hosted testnet, LEZ v0.3.1, deployment testnet-v03-z3) ---------
# ConfigState account, hex (base58 J3NXPWUspX2zqJU3tUbR6MHmm83aJc5AzvidEaBBKnat).
# Testers use registry_id logos:testnet:<this hex>. This file keeps the
# testnet default. Local zone: REGISTRY_REFERENCE=local,
# REGISTRY_CONFIG=7bd1e28e47b1e50f96d806ed96e4214c762ab2b639a9bed2b45dede16099d4db,
# LEZ_RLN_SEQUENCER=http://host.docker.internal:3040/. Keep LEZ_RLN_PAYER*
# empty there too: fund the derived payer by transfer, never carry a genesis
# key across. How to switch and what changes: README §10.
REGISTRY_CONFIG=fd322d32a46ddf57eece9db8d68e9b722262d1f770760fca63b8cb9e7775b971
REGISTRY_REFERENCE=testnet
LEZ_RLN_SEQUENCER=https://testnet.lez.logos.co/

# --- payer ------------------------------------------------------------------
# Leave both empty: the lez module derives a payer on first start, the
# entrypoint logs it and writes it to allocator.json; fund it by transfer (no
# faucet). Set BOTH to import an existing funded key (32-byte hex).
LEZ_RLN_PAYER=
LEZ_RLN_PAYER_KEY=
# Logged as "payer funded" once the balance reaches this (price x rate + fee
# reserve for a few registrations). Informational: serve does not wait for it.
MIN_NATIVE_BALANCE=500000000

# --- auth vectors (all configured ones served at once) ----------------------
# pow-claim: the verifier reads a logos-blockchain node's HTTP API; the node
# must follow the chain the testers mine. The follower in ./node publishes
# its API on the host's loopback at 18080 (README §7); a miner's own node on
# this host works too.
# Set to http://host.docker.internal:18080 once node/ (README §7) reports
# Following/Online; empty = pow-claim not served.
POW_NODE_URL=
# Must equal the producer's audience (empty on both sides is fine).
POW_AUDIENCE=
# eth-allowlist: addresses come from ./config/allowlist.txt (bind-mounted at
# /etc/allocator; one 0x… per line, `#` comments); the entrypoint re-serves
# when the file changes.
# keycard-attestation: comma-separated 33-byte compressed secp256k1 CA public
# keys (hex) the verifier trusts. Empty = the Status production CA only;
# "none" = the vector is not served. A TEST CA (verify-local.sh D8) lets whoever
# holds its private key mint unlimited "cards": append it only on a local
# zone and remove it before the allocator is publicly reachable. Changing it
# needs `docker compose up -d` (env is read at start).
KEYCARD_TRUSTED_CAS=
# A non-production CA is refused unless REGISTRY_REFERENCE=local; 1 overrides.
# ALLOW_TEST_CA=0

# --- gifter ---------------------------------------------------------------
# Every request is clamped to this rate (the registry allows 100..600; the
# membership UI asks for 100).
MAX_RATE_LIMIT=100
# Seconds between health checks (and allowlist re-serve checks); default 30.
# HEALTH_EVERY_S=30
