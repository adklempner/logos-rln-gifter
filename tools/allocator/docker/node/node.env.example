# tools/allocator/docker/node/node.env — copy to node.env and fill in from the
# MINER (the node testers mine on). Read by compose and by run-node.sh.

# The miner's image tag: `grep NODE_IMAGE_LABEL deployment/.env` in its
# logos-blockchain checkout, or
# `docker inspect logos_blockchain_node_0 --format '{{.Config.Image}}'`.
# The follower must run the SAME tag as the miner: the deployment file and the
# protocol names are per release.
NODE_IMAGE_LABEL=

# Comma-separated libp2p multiaddrs this node syncs from, form
# /ip4/<ip>/udp/<port>/quic-v1/p2p/<PeerId>. The chain's bootstrap nodes
# (network.backend.initial_peers in the miner's /node-data/0/user_config.yaml)
# and/or the miner itself (its PeerId: curl -s localhost:18080/network/info).
# Changing this regenerates the node's config and keys (harmless: the follower
# owns nothing).
MINER_PEERS=

# Host UDP port for this node's swarm (also used inside the container). Pick a
# free one: the miner's own stack uses 3000, native nodes here may hold 3000/3100.
NODE_NET_PORT=3000

# Host loopback port for the API; the allocator's POW_NODE_URL points at it.
NODE_API_PORT=18080
