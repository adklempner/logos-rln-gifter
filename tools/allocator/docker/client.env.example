# tools/allocator/docker/client.env — copy to client.env and fill in from the
# allocator operator's allocator.json.
ALLOCATOR_PEER_ID=
# An IPv4 address, never a /dns4/ name (it does not resolve in the container).
ALLOCATOR_MULTIADDR=/ip4/<allocator host ip>/tcp/9000
# gifter_multiaddr or one of allocator.json's alt_multiaddrs goes into
# ALLOCATOR_MULTIADDR.

# What the probe presents: eth-allowlist via the eth_sign_module in this
# image (the address is printed; the operator allowlists it), or "none" for
# an open allocator, or pow-claim via pow_claim_capture_module with
# CLIENT_AUTH_ARGS={"node_url":"http://host.docker.internal:18080","audience":"","rate_max":100}.
# For eth-allowlist, give the module a FIXED key so the address the operator
# allowlists stays the same across runs (a `run --rm` client gets a fresh
# module key otherwise): CLIENT_AUTH_ARGS={"private_key":"0x<32-byte hex>"}.
# logos-allowlist: the key of your own logos-blockchain node (PoWClaim key);
# the probe prints it, give it to the operator:
#   CLIENT_AUTH_TYPE=logos-allowlist
#   CLIENT_AUTH_PROVIDER=logos_sign_module
#   CLIENT_AUTH_ARGS={"node_url":"http://host.docker.internal:18080"}
# (add "public_key":"<64 hex>" when the node has more than one PoWClaim key).
# lez-allowlist: a LEZ account key held by lez_sign_module; the probe prints
# the base58 account id for the operator. Use a FIXED key:
#   CLIENT_AUTH_TYPE=lez-allowlist
#   CLIENT_AUTH_PROVIDER=lez_sign_module
#   CLIENT_AUTH_ARGS={"private_key":"0x<32-byte hex>"}
CLIENT_AUTH_TYPE=eth-allowlist
CLIENT_AUTH_PROVIDER=eth_sign_module
CLIENT_AUTH_ARGS=
CLIENT_RATE=100

# keycard-attestation (or any vector whose payload is made elsewhere): the raw
# auth payload hex, sent as authPayload; CLIENT_AUTH_PROVIDER is then ignored
# and no producer module is loaded. A keycard attestation is bound to one
# identity commitment, so pass the commitment it was minted for, e.g.
#   CLIENT_AUTH_TYPE=keycard-attestation
#   CLIENT_AUTH_PAYLOAD=a0…            (tools/mint_attest.py mint … -> tlv)
#   CLIENT_IDENTITY_COMMITMENT=<the 32-byte hex passed to mint>
# Empty CLIENT_IDENTITY_COMMITMENT = a fresh random one per run.
CLIENT_AUTH_PAYLOAD=
CLIENT_IDENTITY_COMMITMENT=

# 1 keeps the container up after the probe for `docker compose exec client …`.
CLIENT_KEEP=0
