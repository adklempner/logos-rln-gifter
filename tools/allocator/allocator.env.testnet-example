# tools/allocator — hosted testnet (LEZ v0.3.1, deployment testnet-v03-z3).
# Copy to $ALLOCATOR_HOME/allocator.env and fill in the payer. The environment
# wins over this file. Clients must use registry_id
#   logos:testnet:fd322d32a46ddf57eece9db8d68e9b722262d1f770760fca63b8cb9e7775b971
# (the same config account as REGISTRY_CONFIG below, hex form).
#
# Bundles: build against logos-rln-modules main >= a814e7f (liblogos_lez_rln_module
# 5.1.0 — a v0.3.0 bundle cannot sync the reset zone) and logos-rln-gifter
# feat/eth-sign-module (gifter 0.3.0 with the 5.1.0 refusal handling and the
# BN254 pre-check).
LOGOSCORE=
LIBP2P_LGX=
GIFTER_LGX=
LEZ_RLN_LGX=
EXTRA_LGX=                      # e.g. the rln_auth_module bundle
EXTRA_MODULES=rln_auth_module

LISTEN_ADDR=/ip4/0.0.0.0/tcp/9000
# Comma-separated <multiaddr>/p2p/<peerId> of DHT peers the libp2p node
# bootstraps from; serve then advertises on that DHT (and fails when it
# cannot). Empty = the allocator is reachable by pinned peer id only.
# Default: the logos.test fleet entry nodes.
KAD_BOOTSTRAP_NODES=/dns4/node-01.do-ams3.logos.test.status.im/tcp/30303/p2p/16Uiu2HAmQ9X2xDfPG3uL77V9piYDhjq14JhKCtcmNYsTMKNqrKCj,/dns4/node-02.do-ams3.logos.test.status.im/tcp/30303/p2p/16Uiu2HAmB8NYprrfQrgWVzsJtYWkfjsXbmJEGNMG6othXsQ53BwG,/dns4/node-01.gc-us-central1-a.logos.test.status.im/tcp/30303/p2p/16Uiu2HAmF8WtwGPmeGHgYAX2277jHgy5cW9F7zsB8EqUjBZQAZQ3,/dns4/node-02.gc-us-central1-a.logos.test.status.im/tcp/30303/p2p/16Uiu2HAmUuXhUW9bdJpzN1kfDziFiUZo4bszTk66cvr7uuyCHXR7,/dns4/node-01.ac-cn-hongkong-c.logos.test.status.im/tcp/30303/p2p/16Uiu2HAmL3oU95jh1BZHozn3uNhx8HEneirgr8M1jEAapzXGDqRF,/dns4/node-02.ac-cn-hongkong-c.logos.test.status.im/tcp/30303/p2p/16Uiu2HAm28CoBZjpyxsanC8tQpbvZ7bZJnVYuB1EgFzb571qpWsV
ADVERTISE_ADDR=                 # /ip4/<public ip>/tcp/9000 — what clients dial; required when binding 0.0.0.0

# Registry ConfigState account, hex (base58 J3NXPWUspX2zqJU3tUbR6MHmm83aJc5AzvidEaBBKnat).
REGISTRY_CONFIG=fd322d32a46ddf57eece9db8d68e9b722262d1f770760fca63b8cb9e7775b971
PAYER=                          # "" = the lez module's own payer (LEZ_RLN_PAYER below)

# eth-allowlist: list the client devices' eth-allowlist ids
# (rln_sign_module identity '{"auth_type":"eth-allowlist"}' -> id).
# (This file is sourced by bash: JSON values MUST be single-quoted.)
AUTH_VERIFIERS='{"eth-allowlist":{"module":"rln_auth_module","config":{"allowlist":["0x..."]}}}'
MAX_RATE_LIMIT=100

# The lez module's wallet. The sequencer for the reset zone is the hosted
# testnet's (https://testnet.lez.logos.co/); the payer must hold native
# balance for price x rate + the fee reserve per registration. Leave the two
# payer variables unset to let the module derive a payer (read it from
# `wallet_status` / allocator.json and fund it); set BOTH to import one. The
# wallet home (payer seed) defaults to $ALLOCATOR_HOME/wallet-home.
DAEMON_ENV='LEZ_RLN_SEQUENCER=https://testnet.lez.logos.co/'
MIN_NATIVE_BALANCE=5000000000
WALLET_WAIT_S=900
